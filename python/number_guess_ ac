import random

# Step 1: Computer picks a number
secret_number = random.randint(1, 10)

# Step 2: Set up a list to store guesses and a dictionary for results
guesses = []
guess_results = {}

# Step 3: Allow the user to guess multiple times
print("Welcome to the Number Guessing Game!")
print("I'm thinking of a number between 1 and 10.")

while True:
    # Ask for the player's guess
    guess = int(input("Enter your guess: "))

    # Add the guess to the list
    guesses.append(guess)

    # Check if the guess is correct
    if guess == secret_number:
        guess_results[guess] = "Correct!"
        print("🎉 You guessed it right!")
        break
    elif guess < secret_number:
        guess_results[guess] = "Too low"
        print("Try higher.")
    else:
        guess_results[guess] = "Too high"
        print("Try lower.")

# Step 4: Show summary
print("/nGame Over! Here's how you did:")
for guess in guesses:
    print(f"Guess: {guess} → {guess_results[guess]}")
